{
  "name": "trotamundos",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo funcional del sistema Trotamundos (TPE Diseño de Sistemas de Software)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "mocks/*",
    "web"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:contratos": "node infra/scripts/lint-contratos.mjs && vitest run --passWithNoTests contrato",
    "e2e": "vitest run --passWithNoTests --config tests/e2e/vitest.config.ts",
    "nuevo-servicio": "node infra/scripts/nuevo-servicio.ts",
    "mock": "node infra/scripts/mock.ts",
    "infra:secretos": "node infra/scripts/secretos.ts",
    "infra:levantar": "node infra/scripts/infra.ts levantar",
    "infra:bajar": "node infra/scripts/infra.ts bajar",
    "infra:logs": "node infra/scripts/infra.ts logs",
    "infra:reset": "node infra/scripts/infra.ts reset"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.6",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.79.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
