# Configuración del enrutador global (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
PUERTO=8000
NIVEL_LOG=info
# nginx de cada región, por la red global (trotamundos-global).
URL_REGION_1=http://nginx-region-1:8080
URL_REGION_2=http://nginx-region-2:8080
# Región para las solicitudes sin JWT ni X-Region (en la wiki, la más cercana).
REGION_POR_DEFECTO=region-1
# Tiempo máximo para que responda la región.
TIEMPO_MAXIMO_MS=10000
# Tamaño máximo del cuerpo del login y el registro.
LIMITE_CUERPO=1mb
