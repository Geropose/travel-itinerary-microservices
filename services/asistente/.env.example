# Configuración de asistente (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
REGION=region-1
PUERTO=3007
NIVEL_LOG=info
# Base propia del servicio (una base por servicio, ADR-001).
URL_BASE=postgres://asistente:cambiar-clave@postgres:5432/asistente
# RabbitMQ de la región (ADR-002).
URL_BROKER=amqp://trotamundos:cambiar-clave@rabbitmq:5672
# Clave pública del JWT de Autenticación de la región (ADR-014).
URL_JWKS=http://autenticacion:3001/.well-known/jwks.json
# Servicios de la región que invocan los plug-ins (con el JWT del usuario propagado, QA-9).
URL_VIAJES=http://viajes:3004
URL_USUARIOS=http://usuarios:3002
URL_INTEGRACIONES=http://integraciones:3005
# Carpeta con reglas.{es,en}.yaml (opcional; se recargan sin reiniciar).
# DIR_REGLAS=services/asistente/config
# Degradación controlada (ADR-019) y respuestas lentas (QA-12).
TIMEOUT_SERVICIOS_MS=2000
UMBRAL_RESPUESTA_LENTA_MS=3000
TIMEOUT_PROVEEDOR_MS=10000
