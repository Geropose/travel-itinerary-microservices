# Configuración de usuarios (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
REGION=region-1
PUERTO=3002
NIVEL_LOG=info
# Base propia del servicio (una base por servicio, ADR-001).
URL_BASE=postgres://usuarios:cambiar-clave@postgres:5432/usuarios
# RabbitMQ de la región (ADR-002).
URL_BROKER=amqp://trotamundos:cambiar-clave@rabbitmq:5672
# Clave pública del JWT de Autenticación de la región (ADR-014).
URL_JWKS=http://autenticacion:3001/.well-known/jwks.json
# Servicio de Viajes de la región: GET /interna/viajes/{viajeId}/dueno.
URL_VIAJES=http://viajes:3004
# Identificadores de agencias configuradas en Integraciones, separados por coma.
AGENCIAS_CONFIGURADAS=viajes-del-plata
