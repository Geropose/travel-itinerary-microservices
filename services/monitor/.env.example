# Configuración de monitor (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
REGION=region-1
PUERTO=3010
NIVEL_LOG=info
# Proyecto de docker compose de la región (r1 o r2): el monitor vigila sus contenedores.
PROYECTO_DOCKER=r1
# Socket de la API de Docker (se monta en el contenedor).
SOCKET_DOCKER=/var/run/docker.sock
# Ping-echo (ADR-007): cada 5 s; 3 pings sin respuesta (15 s) marcan caída la instancia.
INTERVALO_PING_MS=5000
FALLAS_PARA_CAIDA=3
TIEMPO_PING_MS=2000
# Tiempo para que una instancia reiniciada arranque antes de volver a contar fallas.
GRACIA_REINICIO_MS=60000
