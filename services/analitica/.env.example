# Configuración de analitica (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
REGION=region-1
PUERTO=3006
NIVEL_LOG=info
# Base regional del servicio (idempotencia de eventos de la región, ADR-001).
URL_BASE=postgres://analitica:cambiar-clave@postgres:5432/analitica
# Base global de analítica (histórico anonimizado particionado por mes, ADR-016).
URL_BASE_ANALITICA=postgres://analitica:cambiar-clave@postgres-analitica:5432/analitica
# Secreto regional para HMAC-SHA256(numeroReserva, SECRETO_ANALITICA). Nunca sale de la región.
SECRETO_ANALITICA=cambiar-secreto-analitica-de-al-menos-16-caracteres
# RabbitMQ de la región (ADR-002).
URL_BROKER=amqp://trotamundos:cambiar-clave@rabbitmq:5672
# Clave pública del JWT de Autenticación de la región (ADR-014).
URL_JWKS=http://autenticacion:3001/.well-known/jwks.json
CANTIDAD_CONSUMIDORES=2
PREFETCH_CONSUMIDORES=10
PROCESADORES_MAPREDUCE_DEFECTO=4
