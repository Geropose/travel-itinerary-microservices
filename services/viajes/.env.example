# Configuración de viajes (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
REGION=region-1
PUERTO=3004
NIVEL_LOG=info
# Base propia del servicio (una base por servicio, ADR-001).
URL_BASE=postgres://viajes:cambiar-clave@postgres-viajes:5432/viajes
# Read replica para lecturas del panel (ADR-012).
URL_BASE_LECTURA=postgres://viajes:cambiar-clave@postgres-viajes-replica:5432/viajes
# Cache Redis distribuida del panel (ADR-011).
URL_CACHE=redis://redis:6379
TTL_CACHE_PANEL_S=600
TIMEOUT_CACHE_MS=500
# RabbitMQ de la región (ADR-002).
URL_BROKER=amqp://trotamundos:cambiar-clave@rabbitmq:5672
# Clave pública del JWT de Autenticación de la región (ADR-014).
URL_JWKS=http://autenticacion:3001/.well-known/jwks.json
# Servicios internos de la región (itinerarios compartidos y redes sociales).
URL_USUARIOS=http://usuarios:3002
URL_INTEGRACIONES=http://integraciones:3005
# Cron (UTC) de la tarea de archivado nocturno (Iteración 2, UC-5).
CRON_ARCHIVADO="0 3 * * *"
# Consumidores en paralelo por cola de eventos (ADR-009) y ventana de agrupación en horas.
CANTIDAD_CONSUMIDORES=4
PREFETCH_CONSUMIDORES=5
MARGEN_AGRUPACION_HORAS=48
