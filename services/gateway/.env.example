# Configuración de gateway (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
REGION=region-1
PUERTO=3000
NIVEL_LOG=info
# Base registro_accesos de la región: accesos rechazados (Iteración 5, QA-8, QA-9).
URL_BASE=postgres://gateway:cambiar-clave@postgres:5432/registro_accesos
# RabbitMQ de la región (ADR-002).
URL_BROKER=amqp://trotamundos:cambiar-clave@rabbitmq:5672
# Clave pública del JWT de Autenticación de la región (ADR-014).
URL_JWKS=http://autenticacion:3001/.well-known/jwks.json
# JWKS de Autenticación de la otra región, por la puerta entre regiones del nginx: un JWT de la
# otra región responde 403 (CONST-6).
URL_JWKS_OTRA_REGION=http://nginx:8090/otra-region/autenticacion/.well-known/jwks.json
# Único origen con CORS: la aplicación web.
ORIGEN_WEB=http://localhost:5173
# Tiempo máximo del servicio interno (ms): si no responde, 503.
TIEMPO_MAXIMO_MS=2000
# Tamaño máximo del cuerpo de una solicitud: si lo supera, 413.
LIMITE_CUERPO=1mb
