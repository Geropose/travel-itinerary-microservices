# Configuración de autenticacion (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
REGION=region-1
PUERTO=3001
NIVEL_LOG=info
# Base propia del servicio (una base por servicio, ADR-001).
URL_BASE=postgres://autenticacion:cambiar-clave@postgres:5432/autenticacion
# RabbitMQ de la región (ADR-002).
URL_BROKER=amqp://trotamundos:cambiar-clave@rabbitmq:5672
# Clave privada RS256 del JWT de la región, PEM en base64 en una línea (ADR-014). La genera
# npm run infra:secretos (JWT_CLAVE_PRIVADA_REGION_1 / _2 del .env de la raíz).
JWT_CLAVE_PRIVADA=cambiar-clave-privada-pem-en-base64
# Servicio de Usuarios de la región (POST /interna/cuentas en el registro).
URL_USUARIOS=http://usuarios:3002
# Autenticación de la otra región (GET /interna/cuentas/existe) y su JWKS, por la puerta entre
# regiones del nginx (infra/nginx/region.conf.template, puerto 8090).
URL_OTRA_REGION=http://nginx:8090/otra-region/autenticacion
URL_JWKS_OTRA_REGION=http://nginx:8090/otra-region/autenticacion/.well-known/jwks.json
# URL pública de la otra región: Location de las respuestas 307.
URL_PUBLICA_OTRA_REGION=http://localhost:8082
# Límite de intentos de login fallidos por email (QA-8).
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
# Secreto de cada servicio que puede pedir un token de servicio (SECRETO_SERVICIO_<SERVICIO>).
SECRETO_SERVICIO_CORREO=cambiar-secreto-correo-000000000000000000
SECRETO_SERVICIO_PRUEBAS=cambiar-secreto-pruebas-00000000000000000
# Contraseña del analista de prueba (solo la usa npm run semillas).
CONTRASENA_ANALISTA=cambiar-contrasena-analista
