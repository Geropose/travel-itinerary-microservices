# Configuración de correo (docs/CONVENCIONES.md 4.3). Valores de ejemplo: nunca subir los reales.
REGION=region-1
PUERTO=3003
NIVEL_LOG=info
# Base propia del servicio (una base por servicio, ADR-001).
URL_BASE=postgres://correo:cambiar-clave@postgres:5432/correo
# RabbitMQ de la región (ADR-002).
URL_BROKER=amqp://trotamundos:cambiar-clave@rabbitmq:5672
# Clave pública del JWT de Autenticación de la región (ADR-014).
URL_JWKS=http://autenticacion:3001/.well-known/jwks.json
# Clave AES-256 en base64 (32 bytes) para encriptar tokens de correo en la base (npm run infra:secretos).
CLAVE_TOKENS_CORREO=cambiar-clave-tokens-correo-en-base64-de-32-bytes
# URL de la aplicación web, destino del redirect 302 al volver de /oauth/callback.
URL_WEB=http://localhost:5173
# URL de Gmail (API interna en Docker y pantalla de permiso en el navegador).
URL_GMAIL=http://mock-gmail:4001
URL_PUBLICA_GMAIL=http://localhost:4001
ID_CLIENTE_GMAIL=trotamundos-local.apps.googleusercontent.com
SECRETO_CLIENTE_GMAIL=cambiar-secreto-cliente-gmail
SECRETO_AVISOS_GMAIL=cambiar-secreto-avisos-gmail
# URL de Outlook (API interna en Docker y pantalla de permiso en el navegador).
URL_OUTLOOK=http://mock-outlook:4002
URL_PUBLICA_OUTLOOK=http://localhost:4002
ID_CLIENTE_OUTLOOK=11112222-bbbb-3333-cccc-4444dddd5555
SECRETO_CLIENTE_OUTLOOK=cambiar-secreto-cliente-outlook
# Clientes internos de la región (Examinador y token de servicio).
URL_AUTENTICACION=http://autenticacion:3001
URL_VIAJES=http://viajes:3004
SECRETO_SERVICIO_CORREO=cambiar-secreto-correo
# Intervalos del Examinador (Iteración 2, ADR-010) y backoff ante 429.
INTERVALO_EXAMINADOR_SEG=30
INTERVALO_VIAJE_PROXIMO_MIN=5
INTERVALO_NORMAL_MIN=60
DIAS_VIAJE_PROXIMO=7
CACHE_VIAJES_MIN=10
BACKOFF_429_INICIAL_SEG=30
BACKOFF_429_MAX_SEG=900
