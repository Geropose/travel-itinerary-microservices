# Configuración del mock de Gmail (specs/externos/gmail.md). Valores de ejemplo: nunca subir los reales.
PUERTO=4001
NIVEL_LOG=info
# Cliente OAuth registrado. El Servicio de Correo usa los mismos.
CLIENT_ID=trotamundos-local.apps.googleusercontent.com
CLIENT_SECRET=cambiar-secreto-cliente-gmail
# redirect_uri registrados, uno por región, con el prefijo del enrutador global.
REDIRECT_URIS=http://localhost:8000/region-1/api/correo/oauth/callback,http://localhost:8000/region-2/api/correo/oauth/callback
# Vida del access token en segundos.
VIDA_TOKEN_S=3599
# Cuota de la Gmail API en unidades por minuto por usuario (QA-7).
CUOTA_POR_MINUTO=6000
# Suscripciones push de Pub/Sub, "tópico=url" separadas por coma: el tópico que cada región usa en
# users.watch y la URL de avisos de su Servicio de Correo (con el ?token= secreto).
SUSCRIPCIONES_PUSH=projects/trotamundos/topics/gmail-avisos-region-1=http://localhost:8000/region-1/api/correo/notificaciones/gmail?token=cambiar-secreto-avisos-gmail,projects/trotamundos/topics/gmail-avisos-region-2=http://localhost:8000/region-2/api/correo/notificaciones/gmail?token=cambiar-secreto-avisos-gmail
# Arrancar con los 20 buzones de prueba.
SEMILLAS=true
