# Configuración del mock de Outlook (specs/externos/outlook.md). Valores de ejemplo: nunca subir los reales.
PUERTO=4002
NIVEL_LOG=info
# Aplicación registrada. El Servicio de Correo usa los mismos.
CLIENT_ID=11112222-bbbb-3333-cccc-4444dddd5555
CLIENT_SECRET=cambiar-secreto-cliente-outlook
# redirect_uri registrados, uno por región, con el prefijo del enrutador global.
REDIRECT_URIS=http://localhost:8000/region-1/api/correo/oauth/callback,http://localhost:8000/region-2/api/correo/oauth/callback
# Vida del access token en segundos.
VIDA_TOKEN_S=3599
# Límite de solicitudes a Graph por buzón en cada ventana de segundos (QA-7).
LIMITE_SOLICITUDES=10000
VENTANA_LIMITE_S=600
# Arrancar con los 20 buzones de prueba.
SEMILLAS=true
