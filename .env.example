# Secretos de ejemplo para pedir el token de servicio (POST /interna/tokens-servicio de
# Autenticación). Cambiarlos en cada región; nunca subir los reales.
SECRETO_SERVICIO_AUTENTICACION=cambiar-secreto-autenticacion-0000000000
SECRETO_SERVICIO_CORREO=cambiar-secreto-correo-000000000000000000
SECRETO_SERVICIO_PRUEBAS=cambiar-secreto-pruebas-00000000000000000
