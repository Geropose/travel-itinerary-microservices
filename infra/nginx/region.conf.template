# Balanceador de carga de la región (Iteración 1, QA-4 y QA-5): reparte las solicitudes entre las
# instancias del API Gateway. Escucha en 8080; hacia afuera r1 usa 8081 y r2 8082.

# DNS interno de Docker. Con "resolve", nginx vuelve a consultar cada 5 s y ve las instancias que
# se agregan o se sacan con docker compose --scale gateway=N.
resolver 127.0.0.11 valid=5s ipv6=off;

# Con 3 errores dentro de 15 s, nginx deja de mandarle solicitudes a esa instancia durante 15 s
# (ADR-007 y ADR-008): mientras el monitor la reinicia, el tráfico va a las demás.
upstream gateway {
  zone gateway 64k;
  server gateway:3000 resolve max_fails=3 fail_timeout=15s;
}

# Puerto de cada servicio de la región (docs/CONVENCIONES.md 4.2), para /salud/<servicio>.
map $servicio_salud $puerto_salud {
  default "";
  gateway 3000;
  autenticacion 3001;
  usuarios 3002;
  correo 3003;
  viajes 3004;
  integraciones 3005;
  analitica 3006;
  asistente 3007;
  monitor 3010;
}

server {
  listen 8080;

  # Salud del propio nginx (healthcheck del contenedor).
  location = /nginx/salud {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # GET /health de cada servicio de la región a través del balanceador: lo usan las pruebas de
  # infraestructura y la demo para ver que todo está sano.
  location ~ ^/salud/(?<servicio_salud>[a-z]+)$ {
    if ($puerto_salud = "") {
      return 404;
    }
    proxy_pass http://$servicio_salud:$puerto_salud/health;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
  }

  # Todo lo demás va al API Gateway.
  location / {
    proxy_pass http://gateway;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Si una instancia no contesta (no acepta la conexión o no responde a tiempo), se reintenta en
    # otra y cuenta como falla de esa instancia. Un 502 o 503 que manda el gateway no cuenta: es
    # de un servicio de atrás, y sacar al gateway sano dejaría sin servicio a toda la región
    # (ADR-001, ADR-008; medido en docs/mediciones.md, QA-4).
    proxy_next_upstream error timeout;
    proxy_connect_timeout 2s;
  }
}

# Puerta entre regiones (Iteración 6, ADR-017). Escucha en 8090, que no se publica: solo se llega
# desde la red de la región y desde la red global (el nginx de la otra región). Deja pasar únicamente
# lo que Autenticación comparte con la otra región, que no son datos personales (CONST-6): si una
# cuenta existe (sí o no) y la clave pública del JWT. Las solicitudes llevan el token de servicio de
# Autenticación y no se guardan en el log (llevan el email en la URL).
server {
  listen 8090;
  access_log off;

  # De esta región hacia la otra: lo usa Autenticación en el login desde un dispositivo nuevo y en el
  # registro. ${OTRA_REGION} lo completa la imagen de nginx al arrancar (templates).
  location ~ ^/otra-region/(?<resto>.*)$ {
    set $otra_region nginx-${OTRA_REGION};
    proxy_pass http://$otra_region:8090/esta-region/$resto$is_args$args;
    proxy_connect_timeout 2s;
    proxy_read_timeout 2s;
  }

  # De la otra región hacia esta: solo estas dos rutas de Autenticación.
  location = /esta-region/autenticacion/interna/cuentas/existe {
    set $autenticacion autenticacion;
    proxy_pass http://$autenticacion:3001/interna/cuentas/existe$is_args$args;
  }
  location = /esta-region/autenticacion/.well-known/jwks.json {
    set $autenticacion autenticacion;
    proxy_pass http://$autenticacion:3001/.well-known/jwks.json;
  }

  location / {
    return 404;
  }
}
